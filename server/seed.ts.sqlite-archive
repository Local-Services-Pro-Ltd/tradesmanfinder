const BIOS: Record<string, (b: string, y: number) => string> = {
  default: (b, y) =>
    `${b} has been serving local homeowners for over ${y} years. We pride ourselves on honest pricing, tidy workmanship and turning up when we say we will. Fully covered by public liability insurance and happy to provide references on request.`,
};

function slugify(s: string) {
  return s.toLowerCase().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}

export async function seed() {
  const existing = db.select().from(categories).all();
  if (existing.length > 0) return; // already seeded

  console.log("[seed] seeding database…");

  // categories
  const catRows = CATEGORIES.map((c) => db.insert(categories).values({ ...c }).returning().get());
  const catBySlug: Record<string, number> = {};
  catRows.forEach((c) => (catBySlug[c.slug] = c.id));

  // areas
  const areaRows = AREAS.map((a) =>
    db.insert(areas).values({ slug: a.slug, name: a.name, region: a.region, latitude: a.lat, longitude: a.lng }).returning().get()
  );
  const areaBySlug: Record<string, number> = {};
  areaRows.forEach((a) => (areaBySlug[a.slug] = a.id));

  // tradesmen
  let reviewSeed = 0;
  TRADESMEN.forEach((t, idx) => {
    const years = 5 + ((idx * 7) % 21);
    const cats = [catBySlug[t.cat], ...(t.extra || []).map((s) => catBySlug[s])];
    const reviewCount = 5 + ((idx * 3) % 11); // 5-15
    const slug = slugify(t.biz);
    const phone = `07${String(700000000 + idx * 137911).slice(0, 9)}`;
    const responseTime = [15, 30, 45, 60, 90, 120][idx % 6];
    const tr = db.insert(tradesmen).values({
      slug,
      businessName: t.biz,
      ownerName: t.owner,
      email: `${slug.replace(/-/g, "")}@example.co.uk`,
      phone,
      bio: BIOS.default(t.biz, years),
      postcode: AREAS.find((a) => a.slug === t.area)!.region.split(" ").pop()! + " " + (1 + (idx % 9)) + "AB",
      areaId: areaBySlug[t.area],
      heroImageUrl: imgFor(t.cat),
      gallery: JSON.stringify([imgFor(t.cat), IMG.builder, IMG.plumber]),
      categories: JSON.stringify(cats),
      yearsExperience: years,
      verified: t.verified ?? false,
      insured: true,
      licensed: t.verified ?? false,
      featured: t.featured ?? false,
      ratingAverage: t.rating,
      ratingCount: reviewCount,
      responseTimeMinutes: responseTime,
      createdAt: TS(60 - idx),
    }).returning().get();

    // credits + opening top-up
    db.insert(tradesmanCredits).values({ tradesmanId: tr.id, balance: 5 + (idx % 4) * 5 }).returning().get();
    db.insert(creditTransactions).values({ tradesmanId: tr.id, amount: 10, reason: "Welcome credit pack", relatedJobId: null, createdAt: TS(58 - idx) }).run();

    // reviews — generate reviewCount per tradesman
    const fam = REVIEW_BODIES[t.cat] ? t.cat : "general";
    for (let r = 0; r < reviewCount; r++) {
      reviewSeed++;
      const bodies = REVIEW_BODIES[fam];
      // bias rating around the tradesman's average
      let rating = Math.round(t.rating);
      if (r % 5 === 0 && rating > 3) rating = rating - 1;
      if (r % 7 === 0) rating = 5;
      db.insert(reviews).values({
        tradesmanId: tr.id,
        customerName: REVIEW_NAMES[reviewSeed % REVIEW_NAMES.length],
        rating,
        title: REVIEW_TITLES[reviewSeed % REVIEW_TITLES.length],
        body: bodies[r % bodies.length],
        jobId: null,
        verified: r % 3 !== 0,
        createdAt: TS((reviewSeed * 3) % 200 + 2),
      }).run();
    }
  });

  // 10 sample open jobs
  const allTradesmen = db.select().from(tradesmen).all();
  const sampleJobs = [
    { cat: "plumber", area: "abbey-wood", title: "Leaking kitchen tap needs fixing", urgency: "this_week", budget: "£50 – £150", name: "Helen Carter", desc: "Mixer tap in the kitchen has been dripping for a week and the cold side is stiff. Would like it repaired or replaced." },
    { cat: "builder", area: "plumstead", title: "Single-storey rear extension", urgency: "flexible", budget: "£20,000 – £40,000", name: "Raj Mehta", desc: "Looking to extend the kitchen by 4m into the garden. Have rough plans, need a builder to quote and advise on building regs." },
    { cat: "electrician", area: "greenwich", title: "Consumer unit upgrade + EICR", urgency: "this_week", budget: "£300 – £600", name: "Olivia Grant", desc: "Old fuse board with rewireable fuses. Need a modern consumer unit fitted and an EICR for our rental." },
    { cat: "roofer", area: "woolwich", title: "Slipped tiles after storm", urgency: "emergency", budget: "£150 – £400", name: "Frank Dolan", desc: "A few tiles came off in the wind and there's a small leak in the loft. Need someone out quickly." },
    { cat: "painter-decorator", area: "bromley", title: "Repaint two bedrooms and hallway", urgency: "flexible", budget: "£600 – £1,200", name: "Sue Aldridge", desc: "Walls and ceilings in two bedrooms plus the upstairs hallway. Happy to discuss colours." },
    { cat: "tiler", area: "lewisham", title: "Bathroom wall and floor tiling", urgency: "this_week", budget: "£800 – £1,500", name: "Marcus Bell", desc: "Full bathroom re-tile, around 14 sqm of walls and 3 sqm floor. Tiles already purchased." },
    { cat: "gardener-landscaper", area: "bromley", title: "New fencing and turf", urgency: "flexible", budget: "£1,000 – £2,500", name: "Priya Shah", desc: "Replace 12m of rotten fence panels and lay new turf in the back garden." },
    { cat: "heating-engineer", area: "woolwich", title: "Boiler not firing up", urgency: "emergency", budget: "£100 – £500", name: "Greg Mason", desc: "Combi boiler has no hot water or heating, showing a fault code. Need a Gas Safe engineer asap." },
    { cat: "handyman", area: "dartford", title: "Flat-pack wardrobes and shelves", urgency: "flexible", budget: "£80 – £200", name: "Tina Brooks", desc: "Two flat-pack wardrobes to assemble and a few shelves to put up. Half a day's work." },
    { cat: "locksmith", area: "erith", title: "Locked out of the house", urgency: "emergency", budget: "£60 – £150", name: "Wesley Adkins", desc: "Front door slammed shut with keys inside. Need a non-destructive entry if possible." },
  ];

  sampleJobs.forEach((j, i) => {
    const cId = db.select().from(categories).all().find((c) => c.slug === j.cat)!.id;
    const aId = db.select().from(areas).all().find((a) => a.slug === j.area)!.id;
    const job = db.insert(jobs).values({
      customerName: j.name,
      customerEmail: j.name.toLowerCase().replace(/[^a-z]/g, ".") + "@example.com",
      customerPhone: "07" + String(800000000 + i * 12345).slice(0, 9),
      postcode: AREAS.find((a) => a.slug === j.area)!.region.split(" ").pop()!,
      categoryId: cId,
      areaId: aId,
      title: j.title,
      description: j.desc,
      urgency: j.urgency,
      budgetRange: j.budget,
      photos: JSON.stringify([]),
      status: "open",
      createdAt: TS(i + 1),
    }).returning().get();

    // auto-match: create quote placeholders from top tradesmen in category+area
    const matches = allTradesmen
      .filter((t) => (JSON.parse(t.categories as string) as number[]).includes(cId))
      .sort((a, b) => b.ratingAverage - a.ratingAverage)
      .slice(0, 3);
    matches.forEach((m) => {
      db.insert(quotes).values({
        jobId: job.id,
        tradesmanId: m.id,
        priceEstimate: "",
        message: "",
        status: "sent",
        createdAt: TS(i),
      }).run();
    });
  });

  console.log(`[seed] done: ${CATEGORIES.length} categories, ${AREAS.length} areas, ${TRADESMEN.length} tradesmen, ${reviewSeed} reviews, ${sampleJobs.length} jobs`);
}
