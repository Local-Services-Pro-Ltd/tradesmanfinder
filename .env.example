# TradesmanFinder — example environment file
# Copy to `.env` for local development. Never commit a real `.env`.

# ─────────────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────────────

# Supabase / Postgres connection string. Use the pooled (transaction-mode) URL
# from Supabase → Project Settings → Database → Connection string (URI).
# In local dev a direct connection string is fine; on Vercel use the pooled URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/tradesmanfinder

# Static guard for the admin overview page (`/#/admin`).
# Replace with a real auth check before production.
ADMIN_KEY=tradesman-admin-2024

# ─────────────────────────────────────────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────────────────────────────────────────

# API key from Resend dashboard. Required for lead notification + outcome emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# From address used by transactional mail. Must be a verified Resend domain.
EMAIL_FROM=hello@tradesmanfinder.com

# Where partner-related ops emails are forwarded (manual outreach replies, etc.).
PARTNER_NOTIFICATION_EMAIL=ops@tradesmanfinder.com

# Customer-facing support address surfaced in email footers.
SUPPORT_EMAIL=hello@tradesmanfinder.com

# ─────────────────────────────────────────────────────────────────────────────
# Public URLs (used to build absolute links in emails, OG tags, sitemaps)
# ─────────────────────────────────────────────────────────────────────────────

# Canonical public URL of the production site. No trailing slash.
APP_BASE_URL=https://tradesmanfinder.com

# Older alias still referenced by some modules — set to the same value.
PUBLIC_APP_URL=https://tradesmanfinder.com
PUBLIC_URL=https://tradesmanfinder.com

# ─────────────────────────────────────────────────────────────────────────────
# Stripe (test mode for dev, live mode for prod)
# ─────────────────────────────────────────────────────────────────────────────

# Server-side secret key. Use sk_test_* in dev, sk_live_* only on prod Vercel.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Webhook signing secret from Stripe → Developers → Webhooks → endpoint detail.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Price IDs for the three lead packs and the featured-listing subscription.
# Server-side prices — set per environment (test vs live).
STRIPE_PRICE_LEAD_PACK_STARTER=price_xxxxxxxxxxxx
STRIPE_PRICE_LEAD_PACK_STANDARD=price_xxxxxxxxxxxx
STRIPE_PRICE_LEAD_PACK_PRO=price_xxxxxxxxxxxx
STRIPE_PRICE_FEATURED_MONTHLY=price_xxxxxxxxxxxx

# Mirrored to the client so the buy-credits UI can open Checkout sessions.
# Must be the same value as STRIPE_PRICE_LEAD_PACK_STARTER etc. (Vite inlines
# only variables prefixed `VITE_`.)
VITE_STRIPE_PRICE_LEAD_PACK_STARTER=price_xxxxxxxxxxxx
VITE_STRIPE_PRICE_LEAD_PACK_STANDARD=price_xxxxxxxxxxxx
VITE_STRIPE_PRICE_LEAD_PACK_PRO=price_xxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# Partner Programme (see docs/partners.md)
# ─────────────────────────────────────────────────────────────────────────────

# 1-in-N sampling rate for partner impressions. Default 10 (sample 10%).
# Multiplied back at invoice time so reported figures match true volume.
PARTNER_IMPRESSION_SAMPLE_RATE=10

# Secret used to sign per-partner stats-page tokens and outcome-capture links.
# Rotate via a redeploy — old links remain valid until their expiry timestamp.
PARTNER_OUTCOME_SECRET=change-me-to-a-long-random-string

# Master switch for the placement engine. Set to "true" to enable.
PARTNER_PLACEMENTS_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────────

# Express listens on this port in both dev and prod. Default 5000.
PORT=5000

# Vercel auto-sets NODE_ENV. For local prod-mode testing set to "production".
NODE_ENV=development
