# TradesmanFinder environment variables
# Copy to .env (git-ignored) for local dev, and set the real values in Vercel.

# ── Database (Supabase Postgres) ──
DATABASE_URL=postgresql://user:password@host:6543/postgres

# ── Email (Resend) ──
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=moderation@tradesmanfinder.com

# ── Admin ──
ADMIN_KEY=choose-a-long-random-admin-key

# ── Auth: magic-link sessions (PR-A1) ──
# Secret used to sign session JWTs (HS256). MUST be 32+ random bytes.
# Generate with: openssl rand -base64 32
# Set this in Vercel for BOTH Production and Preview before merging PR-A1 —
# the auth endpoints throw without it.
SESSION_SECRET=replace-with-output-of-openssl-rand-base64-32

# Public base URL used to build the magic-link verify URL in emails.
# Defaults to https://tradesmanfinder.com if unset.
PUBLIC_URL=https://tradesmanfinder.com

# ── Stripe (PR-E1/E2) ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
